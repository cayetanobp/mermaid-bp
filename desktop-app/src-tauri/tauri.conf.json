{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mermaid BP",
  "version": "1.0.0-alpha.2",
  "identifier": "io.github.cayetanobp.mermaid-bp",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/plugins/**"] } }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE.md": "NOTICE.md",
      "../dist/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_RUST_NOTICES.md": "THIRD_PARTY_RUST_NOTICES.md"
    },
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"], "displayLanguageSelector": true } }
  }
}
