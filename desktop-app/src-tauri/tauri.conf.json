{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mermaid BP",
  "version": "1.0.0-beta.1",
  "identifier": "io.github.cayetanobp.mermaid-bp",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/plugins/**"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NDE0MDQxQURCM0U0REIKUldUYjVMT3RRVUJCNXBMbUpOcFM1OU1RdUJWelgrOXBkS2cwVVNxcnhxU1gwTUpwSkR6ZXhjblIK",
      "endpoints": ["https://github.com/cayetanobp/mermaid-bp/releases/download/beta/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE.md": "NOTICE.md",
      "../dist/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../THIRD_PARTY_RUST_NOTICES.md": "THIRD_PARTY_RUST_NOTICES.md"
    },
    "targets": ["nsis", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "linux": { "deb": { "section": "utils", "priority": "optional", "depends": ["libayatana-appindicator3-1"] } },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"], "displayLanguageSelector": false } }
  }
}
