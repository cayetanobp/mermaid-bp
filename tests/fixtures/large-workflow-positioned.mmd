    finish["Finalizar flujo sintético<br/>Paso ficticio para verificar edición, guardado y renderizado"]
  end
  intake -->|abrir| check
  check -->|válido| normalize
  normalize -->|preparar| catalog
  catalog -->|clasificar| tag
  tag -->|continuar| dedupe
  dedupe -->|único| archive
  archive -->|guardar| receipt
  receipt -->|avisar| notify
  notify -->|revisar| retry
  retry -->|repetir si falla| retry
  retry -->|correcto| queue
  queue -->|agrupar| batch
  batch -->|enviar| scan
  scan -->|procesar| transform
  queue -->|registrar| audit
  audit -->|documentar| enrich
  transform -->|indexar| index
  enrich -->|consultar| search
  index -->|comparar| compare
  search -->|unificar| merge
  review -->|confirmar| publish
  compare -->|coincide| merge
  merge -->|inspeccionar| review
  review -->|validar| approve
  approve -->|autorizar| publish
  publish -->|conservar| snapshot
  snapshot -->|medir| metric
  metric -->|informar| report
  report -->|evaluar| alert
  alert -->|atender| triage
  triage -->|delegar| assign
  assign -->|resolver| resolve
  resolve -->|probar| verify
  verify -->|cerrar| close
  close -->|extraer| export
  export -->|respaldar| backup
  backup -->|ensayar| restore
  restore -->|terminar| finish
  verify -->|repetir| retry
  report -->|sin incidencias| finish
  classDef entry fill:#eaf3f8,stroke:#476576,color:#173443;
  classDef process fill:#dcf1e2,stroke:#476576,color:#173443;
  classDef outcome fill:#fff0bf,stroke:#476576,color:#173443;
  class intake,check,normalize,catalog,tag,dedupe,archive,receipt,notify,retry,queue,batch entry;
  class scan,audit,transform,enrich,index,search,compare,merge,review,approve,publish,snapshot process;
  class metric,report,alert,triage,assign,resolve,verify,close,export,backup,restore,finish outcome;
